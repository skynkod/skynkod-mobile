{
  "expo": {
    "name": "skynkod",
    "slug": "skynkod",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.anonymous.skynkod"
    },
    "plugins": [
      "expo-camera",
      "expo-image-picker",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/skynkod-logo-white.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#C5A8BB"
        }
      ],
      "expo-web-browser",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Skynkod uses your approximate location only to know when the sun sets, so night mode starts at the right time."
        }
      ]
    ],
    "android": {
      "package": "com.anonymous.skynkod",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "7ef267a3-e2d1-4f13-b949-7f6391a41a82"
      }
    },
    "scheme": "skynkod"
  }
}
