{
  "expo": {
    "name": "skynkod",
    "slug": "skynkod",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.skynkod.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Skynkod uses the camera to scan product barcodes, to photograph a product you propose, and, with Dekod, to read your skin from a selfie.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Skynkod lets you choose a photo from your library.",
          "cameraPermission": "Skynkod uses the camera to scan product barcodes, to photograph a product you propose, and, with Dekod, to read your skin from a selfie.",
          "microphonePermission": false
        }
      ],
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/skynkod-logo-white.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#C5A8BB"
        }
      ],
      "expo-web-browser",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Skynkod uses your approximate location for your local weather and skin forecast (UV, dry air, heat), and to start night mode at sunset."
        }
      ],
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Skynkod uses Face ID to keep your skin journal private."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Skynkod reads your period dates and sleep to warn you before breakouts. It never writes to Apple Health.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "expo-font",
      "expo-status-bar"
    ],
    "android": {
      "package": "com.skynkod.app",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#C5A8BB"
      }
    },
    "extra": {
      "eas": {
        "projectId": "7ef267a3-e2d1-4f13-b949-7f6391a41a82"
      }
    },
    "scheme": "skynkod"
  }
}
